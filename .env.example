# Copy to .env and fill in. Never commit .env.

# API keys are entered in the GUI (Settings → API keys) and stored encrypted.
# They do not belong in this file. Keys still found here are imported once at
# startup and then ignored; remove them afterwards.

# paper = Alpaca paper account; simulated = recorded bars + fake broker, no network
MODE=paper

# Server and storage
SA_HOST=127.0.0.1
SA_PORT=8000
SA_DATA_DIR=./data
SA_DB_PATH=./data/stock-agent.db

# Access (see SPEC → VPS deployment). Locally: off on 127.0.0.1.
# On the VPS: SA_HOST=0.0.0.0 inside the container, SA_AUTH=required.
# The app refuses to start with SA_AUTH=off on any address other than 127.0.0.1.
SA_AUTH=off
SA_PUBLIC_URL=http://127.0.0.1:8000
SA_TRUSTED_PROXY=
# Instance id, part of every client order id; must differ per copy (sa-local, sa-vps-1)
SA_INSTANCE_ID=sa-local
