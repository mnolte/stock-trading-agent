# Copy to .env and fill in. Never commit .env.

# API keys are entered in the GUI (Settings → API keys) and stored encrypted.
# They do not belong in this file. Keys still found here are imported once at
# startup and then ignored; remove them afterwards.

# paper = Alpaca paper account; simulated = recorded bars + fake broker, no network
MODE=paper

# Server and storage
SA_HOST=127.0.0.1
SA_PORT=8000
SA_DATA_DIR=./data
SA_DB_PATH=./data/stock-agent.db
