# Copy to .env and fill in. Never commit .env.

# Alpaca PAPER keys (Alpaca dashboard, paper account). Live keys are never used.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# OpenAI key for the decision layer
OPENAI_API_KEY=

# Finnhub key for the earnings calendar (free plan)
FINNHUB_API_KEY=

# paper = Alpaca paper account; simulated = recorded bars + fake broker, no network
MODE=paper

# Simulated mode only: pin the frozen clock (ISO 8601). Default: 2026-10-15 09:30 New York.
# SA_SIM_NOW=2026-10-15T17:00:00Z

# Server and storage
SA_HOST=127.0.0.1
SA_PORT=8000
SA_DATA_DIR=./data
SA_DB_PATH=./data/stock-agent.db
